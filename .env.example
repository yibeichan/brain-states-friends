# Copy to .env and set for your environment. The .env file itself is gitignored.
#
# Core paths
#   BASE_DIR    Project root (where this repository is cloned).
#   SCRATCH_DIR Scratch root for intermediate/large outputs. Scripts write under
#               $SCRATCH_DIR/output/ (the DataLad output subdataset lives there).
#   DATA_DIR    Root of the all_about_cneuromod dataset tree. Scripts derive
#               $DATA_DIR/cneuromod/friends, $DATA_DIR/cneuromod/movie10,
#               $DATA_DIR/petit-prince from it.
#   ATLAS_DIR   Directory of dseg atlases, one subdir per atlas, e.g.
#               $ATLAS_DIR/atlas-4S156Parcels/atlas-4S156Parcels_space-fsLR_den-91k_dseg.dlabel.nii
#   ALGONAUTS_DIR  Root of the Algonauts 2025 dataset (scripts use $ALGONAUTS_DIR/stimuli).

BASE_DIR=/path/to/brain-states-friends
SCRATCH_DIR=/path/to/scratch/brain-states-friends
DATA_DIR=/path/to/all_about_cneuromod
ATLAS_DIR=/path/to/atlases
ALGONAUTS_DIR=/path/to/algonauts_2025.competitors
